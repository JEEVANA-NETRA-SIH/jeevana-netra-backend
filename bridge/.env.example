# --- Deployment mode -------------------------------------------------
# none -> no compiled MATLAB artifact (dev fallback; API returns 503)
# cli  -> MATLAB Compiler standalone executable via JEEVANA_NETRA_EXE
# sdk  -> MATLAB Compiler SDK Python package via JEEVANA_NETRA_SDK_PACKAGE
MATLAB_DEPLOY_MODE=none
# JEEVANA_NETRA_EXE=/app/matlab_service/jeevana_netra_service
# (Linux binary built by mcc -m on Linux; see DEPLOYMENT.md. The container
#  invokes the binary directly, not run_jeevana_service.sh.)
# JEEVANA_NETRA_SDK_PACKAGE=jeevana_netra_sdk
# MATLAB_TIMEOUT_SECONDS=600

# --- HTTP / CORS ------------------------------------------------------
# PORT is provided by the platform (Render sets it automatically).
PORT=8000
# Comma separated list of allowed browser origins.
# Keep https://jeevananetra.vercel.app in production.
CORS_ORIGINS=https://jeevananetra.vercel.app,http://localhost:5173,http://127.0.0.1:5173
# Optional shared API key. When set, all /api/* routes require:
#   X-API-Key: <value>
# Leave empty to disable (development only).
JEEVANA_API_KEY=
MAX_UPLOAD_MB=20

# --- Database ----------------------------------------------------------
# SQLite file path (compatible with the MATLAB patient API variable name).
JEEVANA_NETRA_DB=./data/jeevana_netra.db
# For PostgreSQL on Render later:
# DATABASE_URL=postgresql+psycopg://user:pass@host/db

# --- MATLAB Runtime (Linux) -------------------------------------------
# Writable directory MATLAB uses for preferences/cache. Must exist in the
# container and be writable at runtime.
MATLAB_PREFDIR=/tmp/matlab_prefdir
TMP_DIR=/tmp